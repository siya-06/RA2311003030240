//  1. PROJECT SETUP (Node + npm)
// Create project
// mkdir backend-test
// cd backend-test
// Initialize npm
// npm init -y

// creates package.json

// Install packages
// npm install express

// this creates:

// node_modules/
// package-lock.json
// (Optional but good)
// npm install nodemon --save-dev
// 2. BASIC FILE SETUP

// Create main file:

// touch index.js

// Run project:

// node index.js

// OR with nodemon:

// npx nodemon index.js
// 3. .gitignore (VERY IMPORTANT)

// Create file:

// touch .gitignore

// Add this inside:

// node_modules/
// .env
// .DS_Store

// This ensures heavy/unnecessary files are NOT pushed

// 4. GIT SETUP (FULL FLOW)
// Initialize git
// git init
// Add files
// git add .
// Commit
// git commit -m "initial commit"
// 5. PUSH TO GITHUB (EXAM CRITICAL)
// Create repo on GitHub
// Name it: your_roll_number

// Connect repo
// git remote add origin https://github.com/your-username/your-repo-name.git
// Push code
// git branch -M main
// git push -u origin main
// 6. AFTER CHANGES (VERY COMMON STEP)
// git add .
// git commit -m "update"
// git push
// 7. QUICK MEMORY VERSION

// Just remember this flow:

// npm init -y
// npm install express

// git init
// git add .
// git commit -m "msg"

// git remote add origin <url>
// git push -u origin main
